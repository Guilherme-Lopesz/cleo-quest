---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CleoSprite from '@/components/character/CleoSprite.astro';
import { withBase } from '@shared/config/site';
---

<BaseLayout title="Página não encontrada">
  <section class="nf">
    <CleoSprite animation="surprised" frame={0} scale={5} />
    <h1>Essa página sumiu</h1>
    <p class="muted">Provavelmente a Cleo derrubou da mesa. Ela nega.</p>
    <a class="btn" href={withBase('/')}>
      Voltar para o início
    </a>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-3);
    padding: var(--space-7) 0;
  }
</style>
