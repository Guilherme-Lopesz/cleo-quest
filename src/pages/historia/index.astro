---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PhotoCard from '@/components/gallery/PhotoCard.astro';
import Lightbox from '@/components/gallery/Lightbox.astro';
import TimeMachine from '@/components/timeline/TimeMachine.astro';
import { PHOTOS, photoById, photosByIds } from '@/features/gallery/photos';
import {
  diaryEntries,
  museumItems,
  timelineChapters,
  withContent,
} from '@/features/content/collections';
import { PHASES, phaseById } from '@/content/phases';
import { withBase } from '@shared/config/site';

const rendered = (await withContent(await timelineChapters())).map((c) => ({
  ...c,
  photos: photosByIds(c.entry.data.photos),
}));
const diaryRendered = await withContent(await diaryEntries());
const museumRendered = await withContent(await museumItems());
let photoIndex = 0;
---

<BaseLayout
  title="História"
  description="A vida da Cleo em capítulos, com fotos e comentários dela mesma."
>
  <header class="history-head">
    <p class="eyebrow">Capítulos</p>
    <h1>A história da Cleo</h1>
    <p class="muted">Contada por ela mesma, com a precisão que se espera de uma gata.</p>
    <nav aria-label="Fases" class="cluster phase-nav">
      {PHASES.map((p) => (
        <a class="badge" href={`#fase-${p.id}`}>
          {p.title}
        </a>
      ))}
    </nav>
  </header>

  <ol class="timeline">
    {rendered.map(({ entry, Content, photos }) => {
      const phase = phaseById(entry.data.phase);
      return (
        <li
          class="chapter"
          id={`fase-${entry.data.phase}`}
          data-chapter-id={entry.id}
          data-milestone={entry.data.milestone}
        >
          <div class="chapter__marker" aria-hidden="true" />
          <article class="chapter__body card">
            <p class="eyebrow">
              {phase?.title ?? entry.data.phase} · {entry.data.period}
            </p>
            <h2>{entry.data.title}</h2>
            {entry.data.caption && <p class="chapter__caption">“{entry.data.caption}”</p>}
            <div class="chapter__text">
              <Content />
            </div>
            {photos.length > 0 && (
              <ul class="chapter__photos">
                {photos.map((p) => (
                  <PhotoCard photo={p} index={photoIndex++} />
                ))}
              </ul>
            )}
            <a class="chapter__more" href={withBase(`/galeria?fase=${entry.data.phase}`)}>
              Ver todas as fotos desta fase →
            </a>
          </article>
        </li>
      );
    })}
  </ol>

  <TimeMachine photos={PHOTOS} />

  <section class="diary" aria-labelledby="diary-title">
    <p class="eyebrow">Confidencial</p>
    <h2 id="diary-title">Diário secreto</h2>
    <p class="muted">Pensamentos ficcionais, escritos na voz da Cleo. Ela nega tudo.</p>
    <ul class="grid-auto diary__list">
      {diaryRendered.map(({ entry, Content }) => {
        const photo = entry.data.photo ? photoById(entry.data.photo) : undefined;
        return (
          <li class="card diary__entry">
            {photo && (
              <img
                src={withBase(photo.thumbnail)}
                alt={photo.alt}
                width={photo.width}
                height={photo.height}
                loading="lazy"
                decoding="async"
                class="diary__photo"
              />
            )}
            <p class="badge">{entry.data.mood}</p>
            <h3>{entry.data.title}</h3>
            <div class="diary__text">
              <Content />
            </div>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="museum" aria-labelledby="museum-title">
    <p class="eyebrow">Acervo</p>
    <h2 id="museum-title">
      Museu das coisas importantes
      <button
        type="button"
        class="secret-box"
        data-easter-egg="caixa-secreta"
        aria-label="Uma caixa suspeita"
      >
        📦
      </button>
    </h2>
    <ul class="grid-auto museum__list">
      {museumRendered.map(({ entry, Content }) => {
        const photo = entry.data.photo ? photoById(entry.data.photo) : undefined;
        return (
          <li class="card museum__item">
            {photo && (
              <img
                src={withBase(photo.thumbnail)}
                alt={photo.alt}
                width={photo.width}
                height={photo.height}
                loading="lazy"
                decoding="async"
                class="museum__photo"
              />
            )}
            <p class="eyebrow">{entry.data.period}</p>
            <h3>{entry.data.name}</h3>
            <div class="museum__text">
              <Content />
            </div>
          </li>
        );
      })}
    </ul>
  </section>

  <Lightbox photos={PHOTOS} />
</BaseLayout>

<style>
  .history-head {
    margin-bottom: var(--space-6);
  }
  .phase-nav a {
    text-decoration: none;
    color: inherit;
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    display: grid;
    gap: var(--space-6);
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 10px;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--color-border);
    border-radius: 2px;
  }
  .chapter {
    position: relative;
    padding-left: var(--space-7);
    scroll-margin-top: 120px;
  }
  .chapter__marker {
    position: absolute;
    left: 2px;
    top: var(--space-5);
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-primary);
    border: 4px solid var(--color-background);
  }
  .chapter__caption {
    font-style: italic;
    color: var(--color-text-muted);
  }
  .chapter__text :global(p:last-child) {
    margin-bottom: 0;
  }
  .chapter__photos {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0;
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 6.5rem), 1fr));
  }
  .chapter__more {
    font-weight: 700;
  }
  .diary,
  .museum {
    margin-top: var(--space-7);
  }
  .diary__list,
  .museum__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .diary__photo,
  .museum__photo {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin-bottom: var(--space-3);
  }
  .secret-box {
    background: none;
    border: 0;
    font-size: 0.6em;
    opacity: 0.25;
    cursor: pointer;
    vertical-align: middle;
    transition: opacity var(--dur-base) var(--ease);
  }
  .secret-box:hover,
  .secret-box:focus-visible {
    opacity: 1;
  }
  .diary__text :global(p:last-child),
  .museum__text :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
