---
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import CleoWalker from '@/components/character/CleoWalker.astro';
import { SITE } from '@shared/config/site';

interface Props {
  title?: string;
  description?: string;
  /** Oculta a Cleo caminhante (ex.: durante uma partida). */
  hideWalker?: boolean;
}
const { title, description = SITE.tagline, hideWalker = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f3ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1e2234" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <script is:inline>
      // Aplica tema/movimento antes da primeira pintura para evitar flash.
      try {
        var p = JSON.parse(localStorage.getItem('cleo-quest:preferences') || '{}');
        if (p.theme === 'light' || p.theme === 'soneca')
          document.documentElement.setAttribute('data-theme', p.theme);
        if (p.motion === 'reduced') document.documentElement.setAttribute('data-motion', 'reduced');
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">
      Pular para o conteúdo
    </a>
    <Header />
    <main id="conteudo" class="container site-main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {!hideWalker && <CleoWalker />}
    <div id="toasts" class="toasts" aria-live="polite" aria-atomic="false"></div>
    <script>
      const schedule = (fn: () => void) =>
        'requestIdleCallback' in window
          ? requestIdleCallback(fn, { timeout: 2500 })
          : setTimeout(fn, 600);
      schedule(
        () => void import('@/features/integrations/site-events').then((m) => m.mountSiteEvents()),
      );
    </script>
  </body>
</html>

<style is:global>
  .site-main {
    padding-top: var(--space-6);
    min-height: 60dvh;
  }
  .toasts {
    position: fixed;
    top: calc(var(--space-4) + env(safe-area-inset-top));
    right: var(--space-4);
    left: var(--space-4);
    display: grid;
    gap: var(--space-2);
    justify-items: end;
    z-index: 50;
    pointer-events: none;
  }
  .toast {
    pointer-events: auto;
    max-width: 24rem;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
    font-weight: 600;
  }
  .toast--success {
    border-color: var(--color-success);
  }
  .toast--danger {
    border-color: var(--color-danger);
  }
  .pawprint {
    position: absolute;
    transform: translate(-50%, -50%) rotate(-20deg);
    font-size: 14px;
    opacity: 0.7;
    pointer-events: none;
    animation: paw-fade 1.8s forwards;
  }
  @keyframes paw-fade {
    to {
      opacity: 0;
    }
  }
</style>
