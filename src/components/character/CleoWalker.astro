---
/**
 * Cleo pixel art caminhando na base da tela. Carregada em todas as páginas,
 * exceto durante uma partida (o jogo tem sua própria Cleo no HUD).
 */
---

<div
  id="cleo-walker"
  class="cleo-walker"
  data-asset-base={import.meta.env.BASE_URL.replace(/\/$/, '')}
></div>

<script>
  import { mountWalker } from '@/features/character/walker';

  const host = document.getElementById('cleo-walker');
  if (host) {
    const handle = mountWalker(host, host.dataset['assetBase'] ?? '');
    // expõe para integrações (eventos de recompensa, loja etc.)
    (window as unknown as { cleoWalker?: typeof handle }).cleoWalker = handle;
  }
</script>

<style is:global>
  .cleo-walker {
    position: fixed;
    left: 0;
    right: 0;
    bottom: calc(env(safe-area-inset-bottom) + 0px);
    height: calc(32px * var(--sprite-scale) + 28px);
    pointer-events: none;
    z-index: 30;
    overflow: visible;
  }
  .cleo-walker__actor {
    position: absolute;
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    will-change: transform;
  }
  .cleo-walker__hit {
    pointer-events: auto;
    background: none;
    border: 0;
    padding: 0;
    line-height: 0;
    min-width: var(--tap-target);
    min-height: var(--tap-target);
    display: grid;
    place-items: end center;
  }
  .cleo-walker__bubble {
    pointer-events: none;
    max-width: 14rem;
    margin-bottom: 4px;
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    font-size: var(--text-sm);
    line-height: 1.3;
    text-align: center;
    position: relative;
  }
  .cleo-walker__bubble::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 10px;
    height: 10px;
    background: inherit;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    transform: translateX(-50%) rotate(45deg);
  }
  .cleo-sprite {
    --facing: 1;
    display: block;
    position: relative;
    width: calc(var(--w) * var(--sprite-scale));
    height: calc(var(--h) * var(--sprite-scale));
    transform: scaleX(var(--facing));
    transform-origin: center;
  }
  .cleo-sprite__layer {
    position: absolute;
    inset: 0;
    width: var(--w);
    height: var(--h);
    transform: scale(var(--sprite-scale));
    transform-origin: top left;
    background-repeat: no-repeat;
    image-rendering: pixelated;
  }
  @media (max-width: 480px) {
    .cleo-walker {
      --sprite-scale: 2;
    }
  }
</style>
