{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@core/*": ["src/features/game-core/*"],
      "@engine/*": ["src/features/game-engine/*"],
      "@minigames/*": ["src/features/minigames/*"],
      "@infra/*": ["src/infrastructure/*"],
      "@shared/*": ["src/shared/*"]
    },
    "types": ["vitest/globals"],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "scripts/**/*",
    "astro.config.mjs",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["dist", "node_modules", ".astro", "test-results", "playwright-report"]
}
